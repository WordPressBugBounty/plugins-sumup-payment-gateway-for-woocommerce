{
  "name": "sumup-payment-gateway-for-woocommerce",
  "version": "2.18.0",
  "private": true,
  "description": "SumUp's plugin for WooCommerce to accept payments",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "setup": "composer install && ./vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs/ && ./vendor/bin/phpcs --config-set default_standard WordPress",
    "start-dev": "npm run setup && npm run dev",
    "build": "wp-scripts build --config webpack.config.js",
    "dev": "wp-scripts start --config webpack.config.js",
    "lint": "biome check .",
    "i18n:update": "python3 scripts/i18n.py update",
    "i18n:check": "python3 scripts/i18n.py check",
    "fmt": "biome check --write .",
    "zip": "node archiver.js",
    "export": "npm run zip",
    "start": "wp-scripts start --config webpack.config.js",
    "test": "wp-scripts test-unit-jest --runInBand",
    "prezip": "npm run build && npm run release:check",
    "release:check": "node scripts/release.js check",
    "release:prepare": "node scripts/release.js prepare",
    "test:release": "node --test scripts/test-release.js scripts/test-changelog.js"
  },
  "author": "SumUp",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sumup/sumup-plugin-for-woocommerce#readme",
  "devDependencies": {
    "@babel/core": "^7.25.7",
    "@biomejs/biome": "^2.6.4",
    "@wordpress/babel-preset-default": "8.55.0",
    "@wordpress/jest-preset-default": "14.2.0",
    "@wordpress/scripts": "^37.0.0",
    "archiver": "^8.0.0",
    "babel-jest": "30.5.0",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "jest": {
    "preset": "@wordpress/jest-preset-default",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "@wordpress/babel-preset-default"
          ]
        }
      ]
    }
  }
}
