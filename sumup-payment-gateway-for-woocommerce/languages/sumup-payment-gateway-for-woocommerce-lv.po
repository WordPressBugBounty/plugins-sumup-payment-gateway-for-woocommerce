#. Description of the plugin
msgid "Take credit card payments on your store using SumUp."
msgstr "Pieņemiet kredītkaršu maksājumus savā veikalā, izmantojot SumUp."

#: includes/class-wc-sumup-settings.php:52
msgid "This controls the description the user sees during checkout."
msgstr "Tas kontrolē aprakstu, ko lietotājs redz izrakstīšanās laikā."

#: includes/class-wc-sumup-settings.php:45
msgid "This controls the title the user sees during checkout."
msgstr "Tas kontrolē nosaukumu, ko lietotājs redz izrakstīšanās laikā."

#: includes/class-wc-sumup-checkout-service.php:16
msgid "This order does not need another payment."
msgstr "Šim pasūtījumam nav nepieciešams vēl viens maksājums."

#: includes/class-wc-sumup-settings.php:43
msgid "Title"
msgstr "Nosaukums"

#: includes/class-wc-sumup-widget-settings.php:49
msgid "Transaction was unsuccessful. Please check the minimum amount or use another valid card."
msgstr "Transakcija neizdevās. Lūdzu, pārbaudiet minimālo summu vai izmantojiet citu derīgu karti."

#: sumup-payment-gateway-for-woocommerce.php:766
msgid "Unable to continue with Google Pay. Please try again."
msgstr "Neizdevās turpināt ar Google Pay. Mēģiniet vēlreiz."

#: includes/class-wc-sumup-onboarding.php:133
msgid "Unable to determine the merchant code or domain for Google Pay registration."
msgstr "Neizdevās noteikt tirgotāja kodu vai domēnu Google Pay reģistrācijai."

#: sumup-payment-gateway-for-woocommerce.php:769
msgid "Unable to disconnect the SumUp account."
msgstr "Neizdevās atvienot SumUp kontu."

#: includes/class-wc-sumup-widget-settings.php:56
msgid "Unable to initialize SumUp checkout."
msgstr "Neizdevās inicializēt SumUp checkout."

#: includes/class-wc-sumup-checkout-service.php:142 includes/class-wc-sumup-gateway.php:1665 includes/class-wc-sumup-gateway.php:1786
msgid "Unable to initialize SumUp payment. Please try again."
msgstr "Neizdevās sākt SumUp maksājumu. Mēģiniet vēlreiz."

#: includes/class-wc-sumup-onboarding.php:168
msgid "Unable to register your domain with SumUp for Google Pay. Check domain setup in SumUp Dashboard > Settings > For developers > Payment wallets, then try again."
msgstr "Neizdevās reģistrēt domēnu SumUp lietošanai ar Google Pay. Pārbaudiet domēna iestatījumus sadaļā SumUp Dashboard > Settings > For developers > Payment wallets un mēģiniet vēlreiz."

#: sumup-payment-gateway-for-woocommerce.php:763
msgid "Unable to start the SumUp connection."
msgstr "Neizdevās sākt SumUp savienojumu."

#: sumup-payment-gateway-for-woocommerce.php:765
msgid "Unable to start the SumUp connection. Please try again."
msgstr "Neizdevās sākt SumUp savienojumu. Lūdzu, mēģiniet vēlreiz."

#: sumup-payment-gateway-for-woocommerce.php:764
msgid "Unable to validate this website."
msgstr "Neizdevās verificēt šo vietni."

#: includes/class-wc-sumup-gateway.php:1427
msgid "Unable to verify access to this order. Please sign in or reopen the original payment link. If you have already paid, do not pay again."
msgstr "Neizdevās pārbaudīt piekļuvi šim pasūtījumam. Pierakstieties vai vēlreiz atveriet sākotnējo maksājuma saiti. Ja jau samaksājāt, nemaksājiet vēlreiz."

#: includes/class-wc-sumup-gateway.php:1458 includes/class-wc-sumup-widget-settings.php:51
msgid "Unable to verify payment status. Please try again."
msgstr "Neizdevās pārbaudīt maksājuma statusu. Lūdzu, mēģiniet vēlreiz."

#: sumup-payment-gateway-for-woocommerce.php:770
msgid "Unknown error occurred."
msgstr "Radās nezināma kļūda."

#: includes/class-wc-sumup-onboarding.php:114
msgid "Use POST to register a Google Pay domain."
msgstr "Google Pay domēna reģistrācijai izmantojiet POST."

#: sumup-payment-gateway-for-woocommerce.php:288
msgid "Use a publicly reachable HTTPS domain before connecting SumUp. If you are testing locally, use a tunnel such as ngrok or Cloudflare Tunnel and update WordPress Home and Site URL first."
msgstr "Pirms SumUp pievienošanas izmantojiet publiski pieejamu HTTPS domēnu. Ja testējat lokāli, izmantojiet tuneli, piemēram, ngrok vai Cloudflare Tunnel, un vispirms atjauniniet WordPress Home un Site URL."

#: includes/class-wc-sumup-connection-diagnostics.php:92
msgid "Verified"
msgstr "Pārbaudīts"

#: includes/class-wc-sumup-gateway.php:1481 includes/class-wc-sumup-gateway.php:1622 includes/class-wc-sumup-widget-settings.php:54
msgid "We are still waiting for SumUp to confirm this payment. Please wait a moment and refresh the page if the order is not updated automatically."
msgstr "Joprojām gaidām, kad SumUp apstiprinās šo maksājumu. Uzgaidiet brīdi un atsvaidziniet lapu, ja pasūtījums netiek atjaunināts automātiski."

#: sumup-payment-gateway-for-woocommerce.php:880
msgid "When you choose SumUp, payment and billing details are sent to SumUp to process your payment and prevent fraud. The payment widget connects directly to SumUp and may process browser and network information. Card numbers and security codes are handled by SumUp, not stored by this plugin. Orders retain payment identifiers and, where applicable, pending payment instructions. When logging is enabled, WooCommerce logs include order, checkout and transaction identifiers. Review your WooCommerce retention settings and the SumUp Privacy Policy when preparing your store privacy notice."
msgstr "Izvēloties SumUp, maksājuma un rēķina dati tiek nosūtīti SumUp maksājuma apstrādei un krāpšanas novēršanai. Maksājumu logrīks savienojas tieši ar SumUp un var apstrādāt pārlūka un tīkla informāciju. Karšu numurus un drošības kodus apstrādā SumUp, un šis spraudnis tos nesaglabā. Pasūtījumos tiek saglabāti maksājumu identifikatori un attiecīgos gadījumos gaidošo maksājumu norādījumi. Ja žurnalēšana ir iespējota, WooCommerce žurnālos tiek iekļauti pasūtījumu, maksājumu un darījumu identifikatori. Gatavojot veikala privātuma paziņojumu, pārskatiet WooCommerce datu glabāšanas iestatījumus un SumUp privātuma politiku."

#: includes/class-wc-sumup-settings.php:80
msgid "Yes"
msgstr "Jā"

#: includes/class-wc-sumup-connection-diagnostics.php:49
msgid "You cannot manage payment settings."
msgstr "Jūs nevarat pārvaldīt maksājumu iestatījumus."

#: includes/class-wc-sumup-onboarding.php:172
msgid "Your SumUp account or store domain changed. Reload the settings and try again."
msgstr "Jūsu SumUp konts vai veikala domēns ir mainījies. Pārlādējiet iestatījumus un mēģiniet vēlreiz."

#: includes/class-wc-sumup-gateway.php:356 includes/class-wc-sumup-onboarding.php:135 sumup-payment-gateway-for-woocommerce.php:767
msgid "Your domain has been registered with SumUp for Google Pay."
msgstr "Jūsu domēns ir reģistrēts SumUp lietošanai ar Google Pay."

#: sumup-payment-gateway-for-woocommerce.php:296
#, php-format
msgid "Your store is currently using %1$s, which is not publicly reachable. Use a public HTTPS domain before connecting SumUp. If you are testing locally, use a tunnel such as ngrok or Cloudflare Tunnel and update WordPress Home and Site URL first."
msgstr "Jūsu veikals pašlaik izmanto %1$s, kas nav publiski pieejams. Pirms SumUp pievienošanas izmantojiet publisku HTTPS domēnu. Ja testējat lokāli, izmantojiet tuneli, piemēram, ngrok vai Cloudflare Tunnel, un vispirms atjauniniet WordPress Home un Site URL."

#. translators: 1: store currency, 2: connected merchant currency, 3: SumUp settings URL.
#: sumup-payment-gateway-for-woocommerce.php:605
#, php-format
msgid "Your store uses %1$s, but the connected SumUp merchant uses %2$s. Change the store currency back or <a href=\"%3$s\">connect a matching SumUp account</a>."
msgstr "Jūsu veikals izmanto %1$s, bet savienotais SumUp tirgotājs izmanto %2$s. Atjaunojiet veikala iepriekšējo valūtu vai <a href=\"%3$s\">savienojiet atbilstošu SumUp kontu</a>."

#. Author URI of the plugin
msgid "https://sumup.com"
msgstr "https://sumup.com"

